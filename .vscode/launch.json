{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start FastAPI Server (api.py)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/src",
            "args": [
                "api:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run All Scrapers (main.py)",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Scrape Mostaql",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/mostaql_scraper.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Scrape Khamsat",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/Khamsat_scraper.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Scrape Nafezly",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/nafezly_scraper.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Scrape Freelancer",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}/src",
            "program": "${workspaceFolder}/src/Freelancer_scraper.py",
            "console": "integratedTerminal"
        }
    ]
}
