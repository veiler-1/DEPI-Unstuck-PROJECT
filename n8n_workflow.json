    {
      "parameters": {
        "jsCode": "// استخراج وتحويل الوظائف إلى عناصر مستقلة في n8n\nconst rawData = $input.first().json;\nconst jobsList = rawData.jobs || [];\n\nreturn jobsList.map(job => ({\n  json: {\n    id: job.id,\n    platform: job.platform,\n    title: job.title,\n    url: job.url,\n    price: job.price || '',\n    duration: job.duration || '',\n    publish_date: job.publish_date || '',\n    skills: Array.isArray(job.skills) ? job.skills.join(', ') : (job.skills || ''),\n    skills_list: job.skills || [],\n    proposals_count: job.proposals_count || '',\n    status: job.status || '',\n    client_name: job.client_name || '',\n    brief: job.brief || '',\n    description: job.description || '',\n    scraped_at: job.scraped_at || new Date().toISOString()\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
