# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_TIMEOUT=5

# Supabase Cloud Database Configuration (Optional / Recommended)
# Paste from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# AI LLM API Keys (GLM / OpenAI / Gemini for smart parsing)
GLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# SMTP Email Delivery Configuration (for OTP verification & n8n alerts)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_digit_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
